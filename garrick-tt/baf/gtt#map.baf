IF
	OnCreation()
THEN
	RESPONSE #100
		MoveGlobal("gtt#01",Player1,[814.928])
		MoveGlobal("gtt#01",Player2,[812.928])
		MoveGlobal("gtt#01",Player3,[816.928])
		MoveGlobal("gtt#01",Player4,[810.928])
		MoveGlobal("gtt#01",Player5,[808.928])
		MoveGlobal("gtt#01",Player6,[818.928])
		ActionOverride(Player1,Face(8))
		ActionOverride(Player2,Face(8))
		ActionOverride(Player3,Face(8))
		ActionOverride(Player4,Face(8))
		ActionOverride(Player5,Face(8))
		ActionOverride(Player6,Face(8))
		MoveViewPoint([814.928],INSTANT)
END

IF
	OnCreation()
	Global("gtt#01rencontre","GLOBAL",2)
THEN
	RESPONSE #100
		DisplayStringHead(Myself,~There is nothing more to do here.~)
END

IF
	Global("gtt#01rencontre","GLOBAL",1)
	PartyHasItem("gtt#vvv")
THEN
	RESPONSE #100
		SetGlobal("gtt#01rencontre","GLOBAL",2)
END

// remarque sur le violon
IF
	InParty("Garrick")
	!Dead("Garrick")
	!ActuallyInCombat()
	InMyArea(Player1)
	!StateCheck("Garrick",CD_STATE_NOTVALID)
	!StateCheck(Player1,CD_STATE_NOTVALID)
	AreaCheck("GTT#01")
	Global("gtt#garrickviolon1","GLOBAL",0)
	PartyHasItem("gtt#vvv")
THEN
	RESPONSE #100
	SetGlobal("gtt#garrickviolon1","GLOBAL",1)
	ActionOverride("Garrick",StartDialogNoSet(Player1))
END

// remarque sur le barbare
IF
	InParty("Faldorn")
	!Dead("Faldorn")
	!ActuallyInCombat()
	InMyArea(Player1)
	!StateCheck("Faldorn",CD_STATE_NOTVALID)
	!StateCheck(Player1,CD_STATE_NOTVALID)
	AreaCheck("GTT#01")
	Global("gtt#faldornbarbare","GLOBAL",0)
THEN
	RESPONSE #100
	SetGlobal("gtt#faldornbarbare","GLOBAL",1)
	ActionOverride("Faldorn",StartDialogNoSet(Player1))
END
